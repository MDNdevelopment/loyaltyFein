# Credenciales y endpoints de Loopy Loyalty (solo servidor, los leen src/app/api/*).
# NO les pongas el prefijo NEXT_PUBLIC_ — nunca deben llegar al bundle del navegador.
#
# Las rutas de API aceptan los dos nombres (LL_API_KEY ?? NEXT_PUBLIC_LL_API_KEY),
# así que el sitio sigue funcionando con las variables NEXT_PUBLIC_ que ya tiene
# configuradas. Renombralas a estas en cuanto puedas y borra las NEXT_PUBLIC_.
LL_API_KEY=
LL_API_SECRET=
LL_USERNAME=

# ID de la campaña de Loopy Loyalty
URL_PROGRAM=

# Endpoints de Loopy Loyalty
TERMS_URL=
URL_ENROLL=

# Webhooks de n8n (verificar y registrar usuario)
URL_CHECK=
URL_ADD=
